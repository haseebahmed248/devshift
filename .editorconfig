# Shared editor settings. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,ps1}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# NuGet writes these lock files without a final newline.
[packages.lock.json]
insert_final_newline = false
